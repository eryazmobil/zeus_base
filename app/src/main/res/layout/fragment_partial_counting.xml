<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="eryaz.software.basewms.ui.dashboard.counting.partialcounting.PartialCountingVM" />
    </data>

    <eryaz.software.basewms.util.widgets.StateView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        app:sv_ignore_referenced_ids="toolbar">

        <eryaz.software.basewms.util.widgets.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/back_icon"
            app:subTitle="@string/sectional_counting"
            app:title="@string/counting" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/bgColor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar">

                <eryaz.software.basewms.util.widgets.TextInputLayout
                    android:id="@+id/shelfAddress"
                    style="@style/Widget.Zeus.SearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:elevation="10dp"
                    android:hint="@string/shelf_code"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/shelfAddressEdt"
                        style="@style/Widget.Zeus.SearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:text="@={viewModel.searchShelf}"
                        android:textColorHint="@color/logoGray"
                        android:textSize="18sp"
                        app:fontFamily="@font/sogeoui" />
                </eryaz.software.basewms.util.widgets.TextInputLayout>

                <eryaz.software.basewms.util.widgets.TextInputLayout
                    android:id="@+id/searchProductTil"
                    style="@style/Widget.Zeus.SearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:elevation="10dp"
                    isVisible="@{viewModel.shelfIsValid}"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/product_barcode"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/shelfAddress">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchProductEdt"
                        style="@style/Widget.Zeus.SearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:text="@={viewModel.searchProduct}"
                        android:textColorHint="@color/logoGray"
                        android:textSize="18sp"
                        app:fontFamily="@font/sogeoui" />
                </eryaz.software.basewms.util.widgets.TextInputLayout>

                <eryaz.software.basewms.util.widgets.DetailRowTextView
                    android:id="@+id/productDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="8dp"
                    app:changeColor="@color/textColor"
                    app:clientName="@{viewModel.productDetail.product.manufacturerCode}"
                    app:creationTime="@{viewModel.productDetail.product.code}"
                    app:detailTitle="@string/product_details"
                    app:documentNo="@{viewModel.productDetail.product.definition}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/searchProductTil" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/editQuantityView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="@dimen/_13sdp"
                    app:cardElevation="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/productDescription">

                    <EditText
                        android:id="@+id/quantityEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:fontFamily="@font/sogeoui"
                        android:gravity="center"
                        android:hint="@string/qty_big"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:padding="@dimen/_10sdp"
                        android:text="@={viewModel.quantityEdt}"
                        android:textColorHint="@color/colorAccent"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.cardview.widget.CardView>

                <androidx.constraintlayout.widget.Group
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="productDescription,editQuantityView"
                    app:isVisible="@{viewModel.showProductDetail}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/newShelfButton"
                    style="@style/Widget.NewZeusDemo.CountingButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:text="@string/new_shelf"
                    android:textSize="20sp"
                    app:fontFamily="@font/sogeoui"
                    app:layout_constraintEnd_toStartOf="@+id/continueToCounting"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/editQuantityView"
                    app:layout_goneMarginTop="@dimen/_10sdp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueToCounting"
                    style="@style/Widget.NewZeusDemo.CountingButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:text="@string/continue_txt"
                    android:textSize="20sp"
                    android:enabled="@{viewModel.continueEnable}"
                    app:fontFamily="@font/sogeoui"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/newShelfButton"
                    app:layout_constraintTop_toBottomOf="@+id/editQuantityView"
                    app:layout_goneMarginTop="@dimen/_10sdp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/completeCounting"
                    style="@style/Widget.NewZeusDemo.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="24dp"
                    android:text="@string/complete_counting"
                    android:textSize="20sp"
                    app:fontFamily="@font/sogeoui"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/continueToCounting"
                    app:layout_goneMarginTop="@dimen/_10sdp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?colorSurface"
                    app:cardCornerRadius="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/completeCounting"
                    app:layout_constraintVertical_bias="0">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/section1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sogeoui"
                            android:paddingVertical="@dimen/_13sdp"
                            android:paddingStart="@dimen/_13sdp"
                            android:paddingEnd="@dimen/_6sdp"
                            android:text="@string/product_code_big"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toStartOf="@id/section2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:background="@color/gray_f6"
                            app:layout_constraintBottom_toBottomOf="@id/section1"
                            app:layout_constraintStart_toEndOf="@id/section1"
                            app:layout_constraintTop_toTopOf="@id/section1" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/section2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sogeoui"
                            android:gravity="end"
                            android:paddingVertical="@dimen/_13sdp"
                            android:paddingStart="@dimen/_6sdp"
                            android:paddingEnd="@dimen/_13sdp"
                            android:text="@string/qty_big"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/section1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_f6"
                            app:layout_constraintTop_toBottomOf="@id/section1" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginBottom="@dimen/_20sdp"
                            app:layout_constrainedHeight="true"
                            app:layout_constraintTop_toBottomOf="@+id/section1"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_storage_quantity_text"
                            tools:itemCount="2">

                        </androidx.recyclerview.widget.RecyclerView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>


        <include layout="@layout/layout_loading" />

        <include layout="@layout/layout_error" />

    </eryaz.software.basewms.util.widgets.StateView>
</layout>